# autogod-v3-a.service — one goal-loop iteration on lane a (loop/pass.sh).
# A SYSTEM unit (User=jack) so the fleet layout daemon can start/stop it with
# the rest of the rack: "auto" mode on AUTOGOD 1 = this lane's timer running.
[Unit]
Description=AUTOGOD v3 goal loop — one iteration, lane a
After=network.target

[Service]
Type=oneshot
User=jack
Environment=HOME=/home/jack
Environment=AUTOGOD_LANE=a
Environment=VAULT=/data/vault
Environment=AUTOGOD_ROOT=/home/jack/autogod-v3
Environment=AUTOGOD_LAB=/home/jack/lab
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/jack/autogod-v3
ExecStart=/home/jack/autogod-v3/loop/pass.sh
