# autogod-v3-a.service — one goal-loop iteration on lane a (see loop/pass.sh).
[Unit]
Description=AUTOGOD v3 goal loop — one iteration, lane a
After=network.target

[Service]
Type=oneshot
Environment=AUTOGOD_LANE=a
Environment=VAULT=%h/vault
Environment=AUTOGOD_ROOT=%h/autogod-v3
Environment=AUTOGOD_LAB=%h/lab
ExecStart=%h/autogod-v3/loop/pass.sh
