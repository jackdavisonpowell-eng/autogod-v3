# autogod-v3-b.service — the goal-loop, lane b (loop/pass.sh). Persistent:
# pass.sh itself loops iteration after iteration with no gap, so this is a
# long-running service, not a periodic job. There is no timer — "auto" mode
# on AUTOGOD 2 just means this service is started.
# A SYSTEM unit (User=jack) so the fleet layout daemon can start/stop it with
# the rest of the rack.
[Unit]
Description=AUTOGOD v3 goal loop, lane b
After=network.target

[Service]
Type=simple
User=jack
Environment=HOME=/home/jack
Environment=AUTOGOD_LANE=b
Environment=VAULT=/data/vault
Environment=AUTOGOD_ROOT=/home/jack/autogod-v3
Environment=AUTOGOD_LAB=/home/jack/lab
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/jack/autogod-v3
ExecStart=/home/jack/autogod-v3/loop/pass.sh
Restart=always
RestartSec=5
