# Fires every 15 min; systemd will not start a oneshot that is still running,
# and pass.sh skips when the lane's brain is down, so this is effectively
# "run back to back whenever AUTOGOD a is racked".
[Unit]
Description=AUTOGOD v3 goal loop timer, lane a

[Timer]
OnCalendar=*:0/15
Persistent=false
Unit=autogod-v3-a.service

[Install]
WantedBy=timers.target
